{
  "name": "babpls-desktop",
  "productName": "BabPls",
  "version": "0.10.0",
  "description": "BabPls: free, open-source PLS-SEM and CB-SEM software",
  "author": "Dr. Ahmed Youssef",
  "license": "MIT",
  "homepage": "https://github.com/motqenacademy-droid/babpls",
  "main": "main.js",
  "private": true,
  "scripts": {
    "prepare-app": "node prepare.js",
    "start": "node prepare.js && electron .",
    "smoke": "node prepare.js && electron . --smoke",
    "dist": "node prepare.js && node build.js"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "com.babpls.desktop",
    "productName": "BabPls",
    "copyright": "© 2026 Dr. Ahmed Youssef and BabPls contributors",
    "files": [
      "main.js",
      "app/**/*",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BabPls",
      "artifactName": "BabPls-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "BabPls-Portable-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.education",
      "icon": "build/icon.png"
    },
    "dmg": {
      "artifactName": "BabPls-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Education",
      "icon": "build/icon.png",
      "artifactName": "BabPls-${version}-linux-x64.${ext}"
    },
    "publish": null
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/motqenacademy-droid/babpls.git"
  }
}
